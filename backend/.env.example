# LLM API configuration (Gemini / Generative AI or fallback to Rule-Based Mode)
LLM_API_KEY=your_gemini_api_key_here
GITHUB_TOKEN=your_github_pat_here

# Database URL (SQLite local by default, interchangeable with PostgreSQL)
DATABASE_URL=sqlite:///./fix2runbook.db

# Application Configuration
DEBUG=True
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","*"]
